{
  "name": "tencentcloud-agentobs-sdk-pi",
  "version": "0.1.0",
  "description": "Tencent Cloud observability extension for Pi coding agent (>=1.3.0) — GenAI traces (entry/agent/step/chat/tool) uploaded directly to CLS or via OTLP/HTTP",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "genai",
    "observability",
    "tencentcloud",
    "cls",
    "opentelemetry",
    "otlp"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --experimental-strip-types --no-warnings --test --test-force-exit --test-reporter=spec test/e2e/*.test.ts",
    "test:fast": "npm run build && AGENTOBS_E2E_SKIP_SLOW=1 node --experimental-strip-types --no-warnings --test --test-force-exit --test-reporter=spec test/e2e/*.test.ts",
    "check:package": "npm run build && node --experimental-strip-types --no-warnings test/e2e/package-discovery.ts",
    "probe": "node --experimental-strip-types --no-warnings test/e2e/probe.ts",
    "demo": "npm run build && node --experimental-strip-types --no-warnings test/e2e/demo-console.ts",
    "verify:real": "npm run build && node --experimental-strip-types --no-warnings test/real/run.ts",
    "verify:harness": "npm run build && node --experimental-strip-types --no-warnings test/real/harness-run.ts",
    "probe:llm": "node --experimental-strip-types --no-warnings test/real/probe-llm.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "~0.301.1",
    "@opentelemetry/exporter-trace-otlp-proto": "~0.301.1",
    "@opentelemetry/resources": "~3.1.1",
    "@opentelemetry/sdk-trace": "~3.1.1",
    "tencentcloud-cls-sdk-js": "^1.1.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^22.0.0",
    "protobufjs": "~7.6.6",
    "typescript": "^5.6.0"
  }
}
